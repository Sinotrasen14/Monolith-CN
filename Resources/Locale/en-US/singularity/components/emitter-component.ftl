### EmitterComponent

# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = {$target}已锁定访问权限！

# Shows when turning the emitter on/off
comp-emitter-turned-on = {$target}已开启。

comp-emitter-turned-off = {$target}已关闭。

# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = {$target}未锚定在地面上！

# Upgrades
emitter-component-upgrade-fire-rate = 射速

emitter-component-current-type = 当前选定的类型为：{$type}。
emitter-component-type-set = 类型已设置为：{$type}