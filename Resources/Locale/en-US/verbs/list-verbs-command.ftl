### Localization used for the list verbs command.
# Mostly help + error messages.

list-verbs-command-description = 列出玩家可对给定实体使用的所有动词。
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>

list-verbs-command-invalid-args = listverbs 需要 2 个参数。

list-verbs-command-invalid-player-uid = 无法解析玩家 uid，或未传入 "self"。
list-verbs-command-invalid-target-uid = 无法解析目标 uid。

list-verbs-command-invalid-player-entity = 给定的玩家 uid 未对应有效实体。
list-verbs-command-invalid-target-entity = 给定的目标 uid 未对应有效实体。

list-verbs-verb-listing = { $type }：{ $verb }